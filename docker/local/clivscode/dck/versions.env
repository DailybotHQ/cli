# devcontainer-kit base images — the single pin file.
#
# Every external input of the base images is pinned here: base images by tag
# AND digest, every downloaded tool by version AND SHA-256 per architecture,
# deepworkplan-vim by tag AND commit. images/common/install.sh refuses any
# download whose checksum does not match. The Dockerfiles' FROM defaults must
# equal the BASE_* values below (the `images` test scope enforces it).
#
# Format: KEY=value, no spaces, no shell expansion. Sourced by install.sh and
# read by .github/workflows/images.yml and `dck doctor` (drift).
#
# Checksum provenance (recorded 2026-10-09):
#   gh, herdr  — GitHub release asset digests published by the vendor (herdr 0.9.5
#                from herdrdev/herdr, binaries re-hashed against them; recorded 2026-11-17)
#   node       — nodejs.org SHASUMS256.txt for the release (24.22.3, a security
#                release; tarballs re-hashed against it, and the node:24.22.3-trixie-slim
#                index digest read from Docker Hub with NODE_VERSION=24.22.3 in its
#                config; recorded 2026-11-17)
#   nvim       — computed at pin time from the release tarballs (Neovim
#                publishes no checksum file for v0.12.5)
#   deepworkplan-vim — the v1.1.0 release SHA256SUMS / install.sh.sha256 and its
#                peeled tag commit (recorded 2026-11-16)
#   herdr-peers — the sha256 of the v2.2.1 release SHA256SUMS (peeled tag commit
#                6b9f17d8ebffe54ecde68c3bc7c768032be60e92, 37 skill files; recorded 2026-11-17)

# Raised above devcontainer-kit v1.4.4 by hand (recorded 2026-11-20), until a dck release pins them:
#   coding-agents-kit v1.5.2 (tag commit 0fb2c7f1, tarball sha256 from its SHA256SUMS, sums sha256 1cc0caeb...)
#   herdr-peers v2.2.2 (tag commit b59c569d, 37 skill files), deepworkplan-vim v1.1.1 (tag commit 376ace71,
#   installer sha256 = its install.sh.sha256), Dailybot CLI 3.29.3 (PyPI wheel sha256, re-hashed on download)

# Base images
BASE_PYTHON=python:3.13.16-slim-trixie@sha256:bf44cdfcb76cd3b41e879bc058fc37ec5872002ccfde7fcb765e218cde0cd79c
BASE_NODE=node:24.22.3-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0
BASE_DEBIAN=debian:trixie-20261005-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.24@sha256:3af4716e991d6956a41e573eab705d0ee08500cd829ed30293eb8472f372c65a

# GitHub CLI
GH_VERSION=2.102.0
GH_SHA256_AMD64=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386
GH_SHA256_ARM64=7862c86c72f43df3a2d93ddde6f473285b4e2af61b494849846827e513ef6484

# Herdr (terminal workspace manager; the container joins it as an SSH machine)
HERDR_VERSION=0.9.5
HERDR_SHA256_AMD64=14d9e8bc8b4a9e0118d77c32266f76d461f09b40342eb23752960bd89f59929d
HERDR_SHA256_ARM64=17d7536f2da50859523680ef279dffcac8e4a235f4e46fe8da6c2ec44141897c
# herdr-peers (agents inside ask agents on other machines): the tag, and the sha256 of
# that release's SHA256SUMS, against which every installed file is verified
HERDR_PEERS_TAG=v2.2.2
HERDR_PEERS_SUMS_SHA256=138e66c6c734bb1bd743946d5da36b0716f903603d9ae7c2fb315a943db578d3

# Neovim (official release tarball)
NVIM_VERSION=0.12.5
NVIM_SHA256_AMD64=bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875
NVIM_SHA256_ARM64=1aa5ca085249580ae0f91eb14f27ec0919773ff2d99a163d03f3d6c21ac29725

# deepworkplan-vim (editor, GPL-3.0) — installed by its own installer (images/common/editor.sh):
# the release tag, the commit it must resolve to, and the installer's SHA-256 (the
# release's install.sh.sha256 / SHA256SUMS; vim.deepworkplan.com serves the same file)
DWP_VIM_TAG=v1.1.1
DWP_VIM_COMMIT=376ace714b5d9a3a5f21219e8e959fc98c53fd0b
DWP_VIM_INSTALLER_SHA256=c48442f21a4bc50c871934cd66c0583663dbf16343f2bcc6491c267235c80529

# Node.js for the agents layer on flavours without Node (python-3.13, debian)
NODE_VERSION=24.22.3
NODE_SHA256_AMD64=4f2b175a6d53a5c617a80dba2676238a0688cef28c6da4eba35c7d844e66fcfb
NODE_SHA256_ARM64=6e51a2ada00f0011cc266f65d98922b403d7ad88f809ca2aa615a5fe1ce6e86c

# coding-agents-kit tag installed by the agents layer (opt-in, never in the base)
AGENTKIT_TAG=v1.5.2
# sha256 of coding-agents-kit-<tag>.tar.gz, from that release's SHA256SUMS
# (v1.5.1: tag commit 1f31c114e45d24c030e55705f90cf83171e0d355, SHA256SUMS sha256
# fb4c71edec9fc510658045d53994fe9426fb752627a922a03616a832219ee3d1; recorded 2026-11-18)
AGENTKIT_SHA256=9e171b580785ab9aa55002099c378a928e9a48061b634d21ce3e476ddaacae57

# Dailybot CLI for the dailybot layer (opt-in, only when the dailybot addon asks;
# the wheel is downloaded and hash-checked, then installed with uv; never in the base)
DAILYBOT_CLI_VERSION=3.29.3
DAILYBOT_CLI_WHEEL_URL=https://files.pythonhosted.org/packages/75/b0/2f647e2fbfe09eadfaa36f9502db616175918ccf7dfbd02f60bf8bf19bbb/dailybot_cli-3.29.3-py3-none-any.whl
DAILYBOT_CLI_WHEEL_SHA256=049830478f38a277668f1e1ec5aca21af038c17ddc1e02af9cd19f5811d2d234

# uv standalone binary for the dailybot layer on flavours without uv (GitHub release digests)
UV_VERSION=0.12.24
UV_SHA256_AMD64=b4dfaef47d491a7296981f8374a4595f55dbf84e8937c8ecd2983574d8bb3da6
UV_SHA256_ARM64=5231be65f496304623895dacdbf1de8504fec90303684bdf05805aa34414dd21
