# Generated by devcontainer-kit (`dck init`) from .devcontainer/dck.toml.
# The blocks between the dck markers are reconciled by `dck init`; add your
# project's own layers BELOW them — they are never touched. The scripts the
# base block copies live next to this file in dck/ (vendored by `dck init`,
# devcontainer-kit v1.0.0); no shared base image is involved.
# >>> dck:base >>>
# dck:managed v1.0.0 base
# Both ARGs come before any FROM, so they are global (an ARG after a FROM is
# scoped to that stage).
ARG BASE_IMAGE=python:3.14.4-slim-trixie@sha256:2ca02f32b4d9d893863367ce07ec1972819f476dd38d8612f2a9cb6a41cbb727
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.24@sha256:3af4716e991d6956a41e573eab705d0ee08500cd829ed30293eb8472f372c65a
FROM ${UV_IMAGE} AS uv
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# System packages, hardened sshd (no host keys in the image), gh, Herdr,
# Neovim and the uid-1000 user — every download pinned and verified
# (dck/versions.env, dck/install.sh).
COPY dck/versions.env dck/install.sh dck/sshd_config.conf dck/github_known_hosts dck/herdr-config.toml dck/profile.sh /tmp/dck-build/
RUN bash /tmp/dck-build/install.sh python-3.13 nodejs npm

# herdr-peers and Herdr's skill: agents inside ask Herdr agents on other
# machines (the host, other containers). Verified against the pinned release
# sums (dck/peers.sh).
COPY dck/versions.env dck/peers.sh /tmp/dck-peers/
RUN bash /tmp/dck-peers/peers.sh && rm -rf /tmp/dck-peers
COPY --from=uv /uv /uvx /usr/local/bin/
RUN uv --version

# The editor in its own layer: DeepWorkPlan Vim through its official
# installer, verified and run with --strict (dck/editor.sh).
COPY dck/versions.env dck/editor.sh /tmp/dck-editor/
RUN bash /tmp/dck-editor/editor.sh

# The entrypoint library and the opt-in layer installers (dck/).
COPY dck/entrypoint.sh /usr/local/lib/dck/entrypoint.sh
COPY dck/dck-entrypoint /usr/local/bin/dck-entrypoint
COPY dck/layers/ /usr/local/lib/dck/layers/
COPY dck/dck-layer /usr/local/bin/dck-layer
# The standard Herdr sidebar (App · Editor · Development · Agents), created by
# `dck herdr layout` / `dck up` inside the container.
COPY dck/herdr-layout.sh /usr/local/bin/dck-herdr-layout
RUN chmod 0644 /usr/local/lib/dck/entrypoint.sh /usr/local/lib/dck/layers/*.sh \
    && chmod 0755 /usr/local/bin/dck-entrypoint /usr/local/bin/dck-layer /usr/local/bin/dck-herdr-layout

ENV LANG=en_US.UTF-8 \
    EDITOR=nvim \
    VISUAL=nvim \
    GIT_EDITOR=nvim \
    DCK_IMAGE_FLAVOUR=python-3.13 \
    DCK_IMAGE_VERSION=1.0.0

# dck.toml asks for user "dev-user": rename the uid-1000 user. Before WORKDIR: a
# workspace under /home/dev-user would otherwise create that home first, and
# `usermod -m` refuses to move into an existing directory (exit 12).
RUN usermod -l dev-user -d /home/dev-user -m dev \
    && groupmod -n dev-user dev \
    && printf '%s ALL=(root) NOPASSWD:ALL\n' dev-user > /etc/sudoers.d/dev-user \
    && chmod 0440 /etc/sudoers.d/dev-user \
    && rm -f /etc/sudoers.d/dev
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/dck-entrypoint"]
CMD ["sleep", "infinity"]
# <<< dck:base <<<
# >>> dck:layers >>>
# Agents layer (layers.agents = true): coding-agents-kit (ak) from its verified
# release, the pinned Node when the flavour lacks a current one, `ak install`
# (pinned, verified) and the classic + providers presets. Autonomy is ak's default.
# The CLIs installed: DCK_AGENT_CLIS plus each INSTALL_<CLI>_CLI=true (compose
# passes both from the developer's environment or docker/local/.env).
ARG DCK_AGENT_CLIS="claude codex"
ARG INSTALL_CLAUDE_CLI=false
ARG INSTALL_CODEX_CLI=false
RUN DCK_USER=dev-user DCK_AGENT_SUPPORTED="claude codex" dck-layer agents ${DCK_AGENT_CLIS}
# Dailybot layer (layers.dailybot = true): requested by the dailybot addon.
RUN DCK_USER=dev-user dck-layer dailybot
# <<< dck:layers <<<

# Project-specific layers go here (apt packages, language tooling, ...).
#
# The Dailybot CLI's own tooling. The build context is docker/local/clivscode,
# so repository files (pyproject.toml, requirements/) are not copied in: the
# start hook (docker/local/dev-setup-hook.sh) installs the locked development
# requirements and the checkout itself (editable) from the bind mount.

# python-semantic-release in its own virtualenv, isolated from the project's
# dependencies (the start hook installs those into the user site), the same
# major the release workflow uses.
RUN python -m venv /opt/semantic-release \
    && /opt/semantic-release/bin/pip install --no-cache-dir --disable-pip-version-check "python-semantic-release>=10,<11" \
    && ln -s /opt/semantic-release/bin/semantic-release /usr/local/bin/semantic-release \
    && semantic-release --version

# Shell: the repository's dev commands (lint, typecheck, codecheck, clitest,
# pip_update, ...) for every interactive bash of the dev user, and git defaults.
USER dev-user
RUN printf '%s\n' \
        '# The Dailybot CLI dev commands (docker/custom_commands.sh), from the bind mount.' \
        '[ -f /workspace/docker/custom_commands.sh ] && . /workspace/docker/custom_commands.sh' \
        >> /home/dev-user/.bashrc \
    && git config --global init.defaultBranch main \
    && git config --global pull.rebase false
USER root
