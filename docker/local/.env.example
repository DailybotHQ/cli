# Primary compose project. Volume names are <COMPOSE_PROJECT_NAME>_<volume>.
COMPOSE_PROJECT_NAME=dailybotplatformlocal
# Volume prefix for satellite agent/CLI mounts. Compose -p overwrites
# COMPOSE_PROJECT_NAME, so satellites read this. Keep it equal to the line above.
PRIMARY_COMPOSE_PROJECT=dailybotplatformlocal

# Compose interpolation for the CLI dev image.
# Docker Compose and the Dev Containers plugin read this file because it sits
# next to docker-compose.yaml. Runtime values stay in clivscode/.env.

# Satellite SSH ports. The primary's port is ssh_port in .devcontainer/dck.toml
# (22031). Leave this unset: docker.sh gives each satellite its own port
# (22900+id), and a value here would make every satellite publish the same one.
# HERDR_SSH_HOST_PORT=

# Coding-agent CLIs: every one is wired, none is installed by default
# (.devcontainer/dck.toml has clis = []). Choose yours in your dck host profile
# ([agents] clis, applied by `dck up`), or here, per repository, then rebuild.
# With neither, the image has no coding CLI.
# DCK_AGENT_CLIS=claude codex
# INSTALL_CLAUDE_CLI=true
# INSTALL_CODEX_CLI=true
# INSTALL_CURSOR_CLI=true
# INSTALL_OPENCODE_CLI=true
# INSTALL_PI_CLI=true
# INSTALL_CLINE_CLI=true
# INSTALL_GROK_CLI=true
# INSTALL_ANTIGRAVITY_CLI=true
# Runtime values (tokens, provider keys) go in clivscode/.env.

# The host's SSH agent socket, mounted into the container. `dck up` sets it
# itself; Docker Desktop (macOS) needs nothing. On a Linux host that starts
# the stack with `bash dev.sh up`, set it to your agent's socket path (the value
# of $SSH_AUTH_SOCK), or the start fails on the missing default path.
# DCK_HOST_SSH_AUTH_SOCK=
