# Primary compose project. Volume names are <COMPOSE_PROJECT_NAME>_<volume>.
COMPOSE_PROJECT_NAME=dailybotplatformlocal
# Volume prefix for satellite agent/CLI mounts. Compose -p overwrites
# COMPOSE_PROJECT_NAME, so satellites read this. Keep it equal to the line above.
PRIMARY_COMPOSE_PROJECT=dailybotplatformlocal

# Compose interpolation for the CLI dev image.
# Docker Compose and the Dev Containers plugin read this file because it sits
# next to docker-compose.yaml. Runtime values stay in cli/.env.

# Host port for the primary Herdr SSH. Default in the compose file is 22031.
# Leave this unset. docker.sh gives each satellite its own port (22900+id).
# A value here is also read by satellite up, so every satellite would publish
# the same port.
# HERDR_SSH_HOST_PORT=22031

# Opt-in coding CLIs. Only the exact string true installs that CLI at image
# build. Absent, empty, or false skips it. The Dev Containers plugin and
# `bash dev.sh build` both interpolate this file. No secrets belong here.
INSTALL_CLAUDE_CLI=false
INSTALL_CURSOR_CLI=false
INSTALL_CODEX_CLI=false
INSTALL_PI_CLI=false
INSTALL_OPENCODE_CLI=false
INSTALL_CLINE_CLI=false
INSTALL_GROK_CLI=false
