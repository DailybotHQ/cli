# Dailybot CLI devcontainer environment variables
#
# Copy this file to `.env` (same directory) and fill in the values you need.
# `.env` is git-ignored. `.env.example` is committed and must NEVER contain real secrets.
#
# These variables are loaded by docker-compose (see ../docker-compose.yaml `env_file`)
# and consumed by the container entrypoint at startup.

# ---------------------------------------------------------------------------
# PyPI publishing (manual release flow)
# ---------------------------------------------------------------------------
# When either token is set, the entrypoint generates `~/.pypirc` (chmod 600)
# inside the container so `twine upload` works without a hand-crafted file.
# Leave both blank if you don't publish from this devcontainer.
#
# Tokens come from:
#   - PyPI:     https://pypi.org/manage/account/token/
#   - TestPyPI: https://test.pypi.org/manage/account/token/
#
# Use the smallest scope possible (project-scoped to `dailybot-cli`).

PYPI_API_TOKEN=
TESTPYPI_API_TOKEN=

# ---------------------------------------------------------------------------
# clitest local API (optional overrides)
# ---------------------------------------------------------------------------
# Used by `clitest-local` / `clitest --env local`. Defaults: djangovscode:8000
# on the Dailybot devcontainer network. Override only if your local Django
# stack listens elsewhere. For staging/dev/private APIs use:
#   clitest --api-url https://your-api.example.com
#
# CLITEST_LOCAL_HOST=djangovscode
# CLITEST_LOCAL_PORT=8000
#
# Optional persistent credential paths (defaults shown):
# CLITEST_LOCAL_CONFIG_DIR=${HOME}/.dailybot_data/config_local
# CLITEST_CUSTOM_CONFIG_BASE=${HOME}/.dailybot_data/config_custom

# ---------------------------------------------------------------------------
# SSH into the container (for a Herdr machine)
# ---------------------------------------------------------------------------
# The compose file publishes container port 22 on 127.0.0.1:<this port>, so a
# Herdr client on your machine can attach to this container. Change it only if
# the default is already taken on your machine. Never use 2222 — Cursor owns
# 127.0.0.1:2222 on macOS.

# HERDR_SSH_HOST_PORT=22031

# ---------------------------------------------------------------------------
# Optional coding-agent CLIs (image build)
# ---------------------------------------------------------------------------
# Default false. Only the exact string true installs that CLI into the image.
# A default build downloads none of them. Set one to true in .env, then rebuild.
# These are build args, not runtime secrets. Do not put keys here.
INSTALL_CLAUDE_CLI=false
INSTALL_CURSOR_CLI=false
INSTALL_CODEX_CLI=false
INSTALL_PI_CLI=false
INSTALL_OPENCODE_CLI=false
INSTALL_CLINE_CLI=false
INSTALL_GROK_CLI=false

# ---------------------------------------------------------------------------
# AI coding-agent providers (optional)
# ---------------------------------------------------------------------------
# NAMES ONLY in this file — never paste a key value here, and never commit one.
# Put the values in `.env` (git-ignored) next to this file.
#
# Each CLI works with its own login and needs nothing below. These variables are
# only for the `-azure` / `-xai` wrappers in docker/ai_wrappers.sh, which point
# a CLI at another provider. Those wrappers write an env REFERENCE into the
# CLI's config file — the key value itself is never written to disk.
#
# xAI (used by codex-xai, opencode-xai, pi-xai, cline-xai, grokx)
#   Key: https://console.x.ai/ — grokx also accepts `grok login` instead.
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL_DAILY=
# XAI_MODEL_REASONING=
# XAI_DEFAULT_MODEL=
#
# Azure OpenAI / Microsoft Foundry (used by codex-azure, opencode-azure,
# pi-azure, cline-azure). Set the resource OR the full base URL, not both.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESOURCE=
# AZURE_OPENAI_BASE_URL=
# AZURE_OPENAI_MODEL_DAILY=
# AZURE_OPENAI_MODEL_REASONING=
# AZURE_OPENAI_DEFAULT_MODEL=
